{
	"env": {
		"baseIncludePaths": [
			"${workspaceFolder}/Engine/Source",
			"${workspaceFolder}/ThirdParty/assimp/include",
			"${workspaceFolder}/ThirdParty/imgui/imgui",
			"${workspaceFolder}/ThirdParty/meshopt/meshopt/src",
			"${workspaceFolder}/ThirdParty/cereal/cereal/include",
			"${workspaceFolder}/ThirdParty/cgltf/cgltf",
			"${workspaceFolder}/ThirdParty/entt/src",
			"${workspaceFolder}/ThirdParty/glm",
			"${workspaceFolder}/ThirdParty/stb",
			"${workspaceFolder}/ThirdParty/Jolt/JoltPhysics"
		],
		"baseDebugDefines": [
			"GLM_FORCE_INTRINSICS",
			"RE_DEBUG",
			"RE_ENABLE_ASSERT",
			"RE_INTERNAL",
			"JPH_DEBUG",
			"JPH_ENABLE_ASSERTS",
			"TRACK_BROADPHASE_STATS",
			"TRACK_NARROWPHASE_STATS",
			"JPH_TRACK_SIMULATION_STATS",
			"JPH_TRACK_SIMULATION_STATS"
		],
		"baseShippingDefines": [
			"GLM_FORCE_INTRINSICS",
			"RE_SHIPPING"
		]
	},
	"configurations": [
		{
			"name": "Windows (Debug)",
			"includePath": [
				"${baseIncludePaths}"
			],
			"defines": [
				"RE_PLATFORM=Windows",
				"${baseDebugDefines}"
			],
			// "compilerPath": "",
			"cppStandard": "c++20",
			"intelliSenseMode": "msvc-x64"
		},
		{
			"name": "Windows (Shipping)",
			"includePath": [
				"${baseIncludePaths}"
			],
			"defines": [
				"RE_PLATFORM=Windows",
				"${baseShippingDefines}"
			],
			// "compilerPath": "",
			"cppStandard": "c++20",
			"intelliSenseMode": "msvc-x64"
		},
		{
			"name": "Mac (Debug)",
			"includePath": [
				"${baseIncludePaths}",
				"${workspaceFolder}/ThirdParty/metal-cpp"
			],
			"defines": [
				"RE_PLATFORM=Mac",
				"IMGUI_IMPL_METAL_CPP",
				"IMGUI_IMPL_METAL_CPP_EXTENSIONS",
				"${baseDebugDefines}"
			],
			"macFrameworkPath": [
				"/System/Library/Frameworks",
				"/Library/Frameworks"
			],
			"compilerPath": "/usr/bin/clang",
			"cppStandard": "c++20",
			"intelliSenseMode": "macos-clang-arm64"
		},
		{
			"name": "Mac (Shipping)",
			"includePath": [
				"${baseIncludePaths}",
				"IMGUI_IMPL_METAL_CPP",
				"IMGUI_IMPL_METAL_CPP_EXTENSIONS",
				"${workspaceFolder}/ThirdParty/metal-cpp"
			],
			"defines": [
				"RE_PLATFORM=Mac",
				"${baseShippingDefines}"
			],
			"macFrameworkPath": [
				"/System/Library/Frameworks",
				"/Library/Frameworks"
			],
			"compilerPath": "/usr/bin/clang",
			"cppStandard": "c++20",
			"intelliSenseMode": "macos-clang-arm64"
		}
	],
	"version": 4
}