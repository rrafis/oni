{
	"env": {
		"baseIncludePaths": [
			"${workspaceFolder}/Engine/Source",
			"${workspaceFolder}/ThirdParty/entt/src",
			"${workspaceFolder}/ThirdParty/glm",
			"${workspaceFolder}/ThirdParty/stb"
		],
		"baseDebugDefines": [
			"GLM_FORCE_INTRINSICS",
			"RE_DEBUG",
			"RE_ENABLE_ASSERT",
			"RE_INTERNAL"
		],
		"baseShippingDefines": [
			"GLM_FORCE_INTRINSICS",
			"RE_SHIPPING"
		]
	},
	"configurations": [
		{
			"name": "Windows (Debug)",
			"includePath": [
				"${baseIncludePaths}"
			],
			"defines": [
				"RE_PLATFORM=Windows",
				"${baseDebugDefines}"
			],
			// "compilerPath": "",
			"cppStandard": "c++20",
			"intelliSenseMode": "msvc-x64"
		},
		{
			"name": "Windows (Shipping)",
			"includePath": [
				"${baseIncludePaths}"
			],
			"defines": [
				"RE_PLATFORM=Windows",
				"${baseShippingDefines}"
			],
			// "compilerPath": "",
			"cppStandard": "c++20",
			"intelliSenseMode": "msvc-x64"
		},
		{
			"name": "Mac (Debug)",
			"includePath": [
				"${baseIncludePaths}",
				"${workspaceFolder}/ThirdParty/metal-cpp"
			],
			"defines": [
				"RE_PLATFORM=Mac",
				"${baseDebugDefines}"
			],
			"macFrameworkPath": [
				"/System/Library/Frameworks",
				"/Library/Frameworks"
			],
			"compilerPath": "/usr/bin/clang",
			"cppStandard": "c++20",
			"intelliSenseMode": "macos-clang-arm64"
		},
		{
			"name": "Mac (Shipping)",
			"includePath": [
				"${baseIncludePaths}",
				"${workspaceFolder}/ThirdParty/metal-cpp"
			],
			"defines": [
				"RE_PLATFORM=Mac",
				"${baseShippingDefines}"
			],
			"macFrameworkPath": [
				"/System/Library/Frameworks",
				"/Library/Frameworks"
			],
			"compilerPath": "/usr/bin/clang",
			"cppStandard": "c++20",
			"intelliSenseMode": "macos-clang-arm64"
		}
	],
	"version": 4
}