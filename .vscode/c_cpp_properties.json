{
	"env": {
		"baseIncludePaths" : [
			"${workspaceFolder}/Engine/Source",
			"${workspaceFolder}/ThirdParty/entt/src",
			"${workspaceFolder}/ThirdParty/glm"
		]
	},
	"configurations": [
		{
			"name": "Windows (Debug)",
			"includePath": [
				"${baseIncludePaths}"
			],
			"defines": [
				"RE_PLATFORM=Windows",
				"RE_DEBUG",
				"RE_ENABLE_ASSERT",
				"RE_INTERNAL"
			],
			// "compilerPath": "",
			"cppStandard": "c++20",
			"intelliSenseMode": "msvc-x64"
		},
		{
			"name": "Windows (Shipping)",
			"includePath": [
				"${baseIncludePaths}"
			],
			"defines": [
				"RE_PLATFORM=Windows",
				"RE_SHIPPING"
			],
			// "compilerPath": "",
			"cppStandard": "c++20",
			"intelliSenseMode": "msvc-x64"
		},
		{
			"name": "Mac (Debug)",
			"includePath": [
				"${baseIncludePaths}",
				"${workspaceFolder}/ThirdParty/metal-cpp"
			],
			"defines": [
				"RE_PLATFORM=Mac",
				"RE_DEBUG",
				"RE_ENABLE_ASSERT",
				"RE_INTERNAL"
			],
			"macFrameworkPath": [
				"/System/Library/Frameworks",
				"/Library/Frameworks"
			],
			"compilerPath": "/usr/bin/clang",
			"cppStandard": "c++20",
			"intelliSenseMode": "macos-clang-arm64"
		},
		{
			"name": "Mac (Shipping)",
			"includePath": [
				"${baseIncludePaths}",
				"${workspaceFolder}/ThirdParty/metal-cpp"
			],
			"defines": [
				"RE_PLATFORM=Mac",
				"RE_SHIPPING"
			],
			"macFrameworkPath": [
				"/System/Library/Frameworks",
				"/Library/Frameworks"
			],
			"compilerPath": "/usr/bin/clang",
			"cppStandard": "c++20",
			"intelliSenseMode": "macos-clang-arm64"
		}
	],
	"version": 4
}