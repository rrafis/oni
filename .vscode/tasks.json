{
	"tasks": [
		{
			"type": "shell",
			"label": "Build",
			"command": "make",
			"args": [
				"-j12",
				"config=debug_mac"
			],
			"windows": {
				"command": "make",
				"args": [
					"-j12",
					"config=debug_windows"
				],
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": "$gcc",
			"group": "build",
			"detail": "Build Engine and Testbed",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "dedicated"
			},
		},
		{
			"type": "shell",
			"label": "Build Testbed",
			"command": "make",
			"args": [
				"-j12",
				"Testbed",
				"config=debug_mac"
			],
			"windows": {
				"command": "make",
				"args": [
					"-j12",
					"Testbed",
					"config=debug_windows"
				],
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": "$gcc",
			"group": "build",
			"detail": "Build Testbed game",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "dedicated"
			},
		},
		{
			"type": "shell",
			"label": "Generate",
			"command": "ThirdParty/premake/Mac/premake5",
			"args": [
				"gmake"
			],
			"windows": {
				"command": "ThirdParty/premake/Windows/premake5.exe",
				"args": [
					"gmake"
				],
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "Generate solution",
		},
		{
			"type": "shell",
			"label": "Build Shader",
			"command": "xcrun -sdk macosx metal -c -frecord-sources -gline-tables-only Content/Shaders/BuiltIn.MaterialShader.metal -o Content/Shaders/BuiltIn.MaterialShader.metal.air && xcrun -sdk macosx metal -frecord-sources -gline-tables-only -o Content/Shaders/BuiltIn.MaterialShader.metallib Content/Shaders/BuiltIn.MaterialShader.metal.air",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "Generate solution",
		},
	],
	"version": "2.0.0"
}